# arena_coords.example.env  --  Criterion 3 coordinates (TEMPLATE)
#
# Copy to arena_coords.env on competition day and fill in the LIVE map-frame
# coordinates you read in RViz (Publish Point -> /clicked_point). Then:
#     source scripts/arena_coords.env
#
# DO NOT commit the filled-in arena_coords.env to the public repo. It is listed
# in .gitignore. Leave only this template tracked.

# --- Predefined (baseline) route, for comparison evidence ---
export BASE_WP1_X=0.0 ; export BASE_WP1_Y=0.0
export BASE_WP2_X=0.0 ; export BASE_WP2_Y=0.0
export BASE_WP3_X=0.0 ; export BASE_WP3_Y=0.0

# --- Human prop (15 cm, below the LiDAR plane -> invisible) : Criterion 3.2 ---
export HUMAN_X=0.0 ; export HUMAN_Y=0.0
# a point just BEYOND the human from the robot, so the straight leg crosses it:
export BEYOND_HUMAN_X=0.0 ; export BEYOND_HUMAN_Y=0.0

# --- Excavator prop (25 cm, visible to LiDAR -> avoided) : Criterion 3.3 ---
export EXCAV_X=0.0 ; export EXCAV_Y=0.0
export BEYOND_EXCAV_X=0.0 ; export BEYOND_EXCAV_Y=0.0

# --- Live network values (confirm on the day; never reuse old ones blindly) ---
export ROBOT_IP=REPLACE_ME
export LAPTOP_IP=REPLACE_ME
